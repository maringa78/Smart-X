@using SmartX.Client.Services
@inject AppState State
@inject NavigationManager Nav

@if (_visible)
{
    <div class="intro-backdrop @(_isExiting ? "fade-out" : "fade-in")" @onclick="DismissIntro">
        <div class="intro-container @(_isExiting ? "scale-down" : "scale-up")" @onclick:stopPropagation="true">
            <header class="intro-header">
                <span class="intro-pill">
                    <span class="intro-pill-dot"></span>
                    Industrial IoT Gateway v2.0
                </span>
                <button type="button" class="intro-close-btn" @onclick="DismissIntro" aria-label="Close introduction">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </header>

            <div class="intro-hero-visual">
                <div class="intro-logo-stage">
                    <img src="images/smartx-logo.jpg" alt="Smart-X Gateway Logo" class="intro-logo-img" />
                </div>
                
                <h1 class="intro-title">
                    Welcome to <span class="gradient-text">Smart-X</span> Gateway
                </h1>
                <p class="intro-subtitle">
                    The next-generation distributed sensor telemetry, command stream orchestrator, and self-healing mesh routing topology engine.
                </p>
            </div>

            <div class="intro-pillars-grid">
                <div class="intro-pillar-card" @onclick='() => NavigateTo("/sensors")'>
                    <div class="pillar-icon pillar-sensors">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zm0 10c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z" />
                        </svg>
                    </div>
                    <div class="pillar-text">
                        <span class="pillar-number">Pillar 01</span>
                        <h3 class="pillar-title">Sensor Ingestion</h3>
                        <p class="pillar-desc">Real-time telemetry ingestion, live health monitoring, and multi-sensor provisioning.</p>
                    </div>
                </div>

                <div class="intro-pillar-card" @onclick='() => NavigateTo("/commands")'>
                    <div class="pillar-icon pillar-commands">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="4 17 10 11 4 5"></polyline>
                            <line x1="12" y1="19" x2="20" y2="19"></line>
                        </svg>
                    </div>
                    <div class="pillar-text">
                        <span class="pillar-number">Pillar 02</span>
                        <h3 class="pillar-title">Command Stream</h3>
                        <p class="pillar-desc">Predictive action triggers, manual command overrides, priority queues, and undo stack.</p>
                    </div>
                </div>

                <div class="intro-pillar-card" @onclick='() => NavigateTo("/topology")'>
                    <div class="pillar-icon pillar-mesh">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </div>
                    <div class="pillar-text">
                        <span class="pillar-number">Pillar 03</span>
                        <h3 class="pillar-title">Mesh Routing</h3>
                        <p class="pillar-desc">Interactive topology graph, Prim's MST routing, detour pathfinding, and failover simulation.</p>
                    </div>
                </div>
            </div>

            <footer class="intro-footer">
                <button type="button" class="btn-intro-secondary" @onclick="DismissIntro">
                    Explore Platform
                </button>
                <button type="button" class="btn-intro-primary" @onclick='() => NavigateTo("/sensors")'>
                    Launch Dashboard
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </footer>
        </div>
    </div>
}

@code {
    private bool _visible;
    private bool _isExiting;

    protected override void OnInitialized()
    {
        // Only show if not yet dismissed in this circuit/session
        _visible = !State.IntroDismissed;
    }

    public void Show()
    {
        State.IntroDismissed = false;
        _isExiting = false;
        _visible = true;
        StateHasChanged();
    }

    private async Task DismissIntro()
    {
        _isExiting = true;
        StateHasChanged();
        await Task.Delay(260); // Allow exit transition to complete
        _visible = false;
        _isExiting = false;
        State.IntroDismissed = true;
        StateHasChanged();
    }

    private async Task NavigateTo(string url)
    {
        await DismissIntro();
        Nav.NavigateTo(url);
    }
}

