@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <header class="topbar">
        <div class="brand">
            <a href="/" class="brand-link" title="Smart-X Gateway">
                <img src="images/smartx-logo.svg" alt="Smart-X Gateway" />
            </a>
        </div>
        <nav class="topbar-nav" aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/sensors">Sensor Ingestion &amp; Telemetry</NavLink>
            <NavLink href="/commands">Command Stream &amp; History</NavLink>
            <NavLink href="/topology">Network Topology &amp; Mesh Routing</NavLink>
            <button type="button"
                    class="theme-toggle @(_isDarkTheme ? "is-dark" : "")"
                    aria-label="@(_isDarkTheme ? "Switch to light mode" : "Switch to dark mode")"
                    aria-pressed="@_isDarkTheme"
                    @onclick="ToggleThemeAsync">
                <span class="theme-toggle-label">@(_isDarkTheme ? "Dark" : "Light") mode</span>
                <span class="theme-toggle-track" aria-hidden="true">
                    <span class="theme-toggle-thumb"></span>
                </span>
            </button>
        </nav>
    </header>
    <main class="page-content">
        @Body
    </main>

    <IntroLandingModal />
</div>

@code {
    private bool _isDarkTheme;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var savedTheme = await JS.InvokeAsync<string?>("smartXTheme.get");
        var isDarkTheme = savedTheme == "dark";
        await JS.InvokeVoidAsync("smartXTheme.set", isDarkTheme ? "dark" : "light");

        if (_isDarkTheme != isDarkTheme)
        {
            _isDarkTheme = isDarkTheme;
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkTheme = !_isDarkTheme;
        await JS.InvokeVoidAsync("smartXTheme.set", _isDarkTheme ? "dark" : "light");
    }
}
