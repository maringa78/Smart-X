@page "/sensors"
@rendermode InteractiveServer
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SmartXApiClient Api
@implements IDisposable

<h1>Sensor Data Ingestion and Telemetry</h1>

<section class="card">
    <h2>Register a sensor</h2>
    <EditForm Model="_newSensor" OnValidSubmit="RegisterSensor">
        <div class="form-row">
            <label>MAC address</label>
            <InputText @bind-Value="_newSensor.MacAddress" placeholder="AA:BB:CC:00:11:22" />
        </div>
        <div class="form-row">
            <label>Deployment location</label>
            <InputText @bind-Value="_newSensor.DeploymentLocation" placeholder="SubZoneB/Zone1/FacilityA" />
        </div>
        <div class="form-row">
            <label>Category</label>
            <InputSelect @bind-Value="_newSensor.Category">
                @foreach (var category in Enum.GetValues<SensorCategory>())
                {
                    <option value="@category">@category</option>
                }
            </InputSelect>
        </div>
        <button type="submit" class="btn-primary">Register sensor</button>
    </EditForm>
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <p class="status">@_statusMessage</p>
    }
</section>

<section class="card">
    <h2>Registered sensors</h2>
    @if (_sensors.Count == 0)
    {
        <p>No sensors registered yet.</p>
    }
    else
    {
        <table class="sensor-table">
            <thead>
                <tr><th>MAC</th><th>Location</th><th>Category</th><th>Attach log/photo</th></tr>
            </thead>
            <tbody>
                @foreach (var sensor in _sensors)
                {
                    <tr>
                        <td>@sensor.MacAddress</td>
                        <td>@sensor.DeploymentLocation</td>
                        <td>@sensor.Category</td>
                        <td>
                            <InputFile OnChange="@(e => UploadFile(sensor.MacAddress, e))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card">
    <h2 class="live-heading"><span class="live-dot"></span>Live telemetry — priority alerts</h2>
    <p class="hint">Readings are colour-coded by severity so anomalies stand out immediately.</p>
    <button class="btn-secondary" @onclick="SimulateReading">Simulate incoming reading</button>

    @if (_telemetry.Count == 0)
    {
        <p>No telemetry received yet.</p>
    }
    else
    {
        <ul class="telemetry-feed">
            @foreach (var packet in _telemetry.OrderByDescending(t => t.Timestamp).Take(15))
            {
                <li class="telemetry-item severity-@packet.Severity">
                    <span class="badge">@packet.Severity.ToUpper()</span>
                    <span>@packet.SensorId</span>
                    <span>@packet.Value.ToString("F1")@packet.Unit</span>
                    <span class="ts">@packet.Timestamp.ToString("HH:mm:ss")</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    private readonly SensorRecord _newSensor = new();
    private List<SensorRecord> _sensors = new();
    private List<TelemetryPacket> _telemetry = new();
    private string? _statusMessage;
    private readonly Random _random = new();
    private Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        _sensors = await Api.GetSensorsAsync();
        _pollTimer = new Timer(async _ => await RefreshSensors(), null, 0, 5000);
    }

    private async Task RefreshSensors()
    {
        _sensors = await Api.GetSensorsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RegisterSensor()
    {
        await Api.RegisterSensorAsync(_newSensor);
        _statusMessage = $"Sensor {_newSensor.MacAddress} registered.";
        _sensors = await Api.GetSensorsAsync();
        _newSensor.MacAddress = string.Empty;
        _newSensor.DeploymentLocation = string.Empty;
    }

    private async Task UploadFile(string mac, Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var success = await Api.UploadFileAsync(mac, stream, e.File.Name);
        _statusMessage = success ? $"Uploaded {e.File.Name} to {mac}." : "Upload failed.";
    }

    // Demo helper: simulates a telemetry reading arriving at the gateway so the
    // severity-based dashboard feature can be shown without live hardware.
    private async Task SimulateReading()
    {
        if (_sensors.Count == 0)
        {
            _statusMessage = "Register a sensor first.";
            return;
        }

        var sensor = _sensors[_random.Next(_sensors.Count)];
        var packet = new TelemetryPacket
        {
            SensorId = sensor.MacAddress,
            Value = _random.Next(0, 120),
            Unit = sensor.Category == SensorCategory.PowerConsumption ? "W" : "%"
        };

        await Api.SubmitTelemetryAsync(packet);
        _telemetry.Add(packet);
    }

    public void Dispose() => _pollTimer?.Dispose();
}