@page "/sensors"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SmartXApiClient Api
@inject AppState State
@implements IDisposable

<div style="margin-bottom: var(--space-3xl);">
    <h1>Sensor Network</h1>
    <p style="color: var(--text-secondary); font-size: 1.05rem;">Register, monitor, and manage your IoT sensor infrastructure</p>
</div>

<section class="card">
    <h2>Register new sensor</h2>
    <p style="color: var(--text-tertiary); margin-bottom: var(--space-lg);">Add a new IoT device to your network</p>
    <EditForm Model="State.NewSensorDraft" OnValidSubmit="RegisterSensor">
        <div class="form-row">
            <label>MAC address</label>
            <InputText @bind-Value="State.NewSensorDraft.MacAddress" placeholder="AA:BB:CC:00:11:22" />
        </div>
        <div class="form-row">
            <label>Deployment location</label>
            <InputText @bind-Value="State.NewSensorDraft.DeploymentLocation" placeholder="SubZoneB/Zone1/FacilityA" />
        </div>
        <div class="form-row">
            <label>Sensor category</label>
            <InputSelect @bind-Value="State.NewSensorDraft.Category">
                @foreach (var category in Enum.GetValues<SensorCategory>())
                {
                    <option value="@category">@category</option>
                }
            </InputSelect>
        </div>
        <button type="submit" class="btn-primary">Register sensor</button>
    </EditForm>
    @if (!string.IsNullOrEmpty(State.SensorsStatusMessage))
    {
        <p style="color: var(--color-primary); margin-top: var(--space-lg); font-weight: 500;">✓ @State.SensorsStatusMessage</p>
    }
</section>

<section class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-lg);">
        <div>
            <h2>Connected sensors</h2>
            <p style="color: var(--text-tertiary);">@(_sensors.Count) device@(_sensors.Count != 1 ? "s" : "") registered</p>
        </div>
        @if (_sensors.Count > 0)
        {
            <span style="font-size: 0.85rem; background: rgba(6, 182, 212, 0.15); color: var(--color-primary); padding: var(--space-sm) var(--space-md); border-radius: var(--radius-sm);">
                ✓ Network online
            </span>
        }
    </div>

    @if (_sensors.Count == 0)
    {
        <p style="color: var(--text-tertiary); padding: var(--space-xl) 0; text-align: center;">
            No sensors registered yet. Add your first sensor to get started.
        </p>
    }
    else
    {
        <table class="sensor-table">
            <thead>
                <tr>
                    <th>Device ID</th>
                    <th>Location</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sensor in _sensors)
                {
                    <tr>
                        <td style="font-family: var(--font-mono); font-size: 0.9rem;">@sensor.MacAddress</td>
                        <td>@sensor.DeploymentLocation</td>
                        <td>
                            <span style="font-size: 0.85rem; background: rgba(94, 173, 212, 0.1); color: var(--text-secondary); padding: var(--space-sm) var(--space-md); border-radius: var(--radius-sm); display: inline-block;">
                                @sensor.Category
                            </span>
                        </td>
                        <td>
                            <InputFile OnChange="@(e => UploadFile(sensor.MacAddress, e))" style="font-size: 0.85rem; cursor: pointer; color: var(--color-primary);" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card">
    <div class="live-indicator">
        <span class="live-dot"></span>
        <h2 class="live-heading">Live telemetry stream</h2>
    </div>
    <p style="color: var(--text-tertiary); margin-bottom: var(--space-lg);">Real-time sensor readings with severity indicators</p>
    <button class="btn-secondary" @onclick="SimulateReading">Simulate reading</button>

    @if (State.TelemetryFeed.Count == 0)
    {
        <p style="color: var(--text-tertiary); padding: var(--space-xl) 0; text-align: center;">
            Waiting for telemetry data...
        </p>
    }
    else
    {
        <ul class="telemetry-feed">
            @foreach (var packet in State.TelemetryFeed.OrderByDescending(t => t.Timestamp).Take(15))
            {
                <li class="telemetry-item severity-@packet.Severity">
                    <span class="telemetry-badge">@packet.Severity.ToUpper()</span>
                    <span>@packet.SensorId</span>
                    <span style="font-weight: 600; color: var(--text-primary);">@packet.Value.ToString("F1")@packet.Unit</span>
                    <span class="telemetry-time">@packet.Timestamp.ToString("HH:mm:ss")</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    private List<SensorRecord> _sensors = new();
    private readonly Random _random = new();
    private Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        _sensors = await Api.GetSensorsAsync();
        _pollTimer = new Timer(async _ => await RefreshSensors(), null, 0, 5000);
    }

    private async Task RefreshSensors()
    {
        _sensors = await Api.GetSensorsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RegisterSensor()
    {
        await Api.RegisterSensorAsync(State.NewSensorDraft);
        State.SensorsStatusMessage = $"Sensor {State.NewSensorDraft.MacAddress} registered successfully.";
        _sensors = await Api.GetSensorsAsync();
        State.NewSensorDraft.MacAddress = string.Empty;
        State.NewSensorDraft.DeploymentLocation = string.Empty;
    }

    private async Task UploadFile(string mac, Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var success = await Api.UploadFileAsync(mac, stream, e.File.Name);
        State.SensorsStatusMessage = success ? $"Uploaded {e.File.Name}" : "Upload failed.";
    }

    private async Task SimulateReading()
    {
        if (_sensors.Count == 0)
        {
            State.SensorsStatusMessage = "Register a sensor first to simulate readings.";
            return;
        }

        var sensor = _sensors[_random.Next(_sensors.Count)];
        var packet = new TelemetryPacket
        {
            SensorId = sensor.MacAddress,
            Value = _random.Next(0, 120),
            Unit = sensor.Category == SensorCategory.PowerConsumption ? "W" : "%"
        };

        await Api.SubmitTelemetryAsync(packet);
        State.TelemetryFeed.Add(packet);
    }

    public void Dispose() => _pollTimer?.Dispose();
}