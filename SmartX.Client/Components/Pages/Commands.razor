@page "/commands"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SmartXApiClient Api
@inject AppState State
@implements IDisposable

<PageTitle>Command Stream &amp; History</PageTitle>

<div style="margin-bottom: var(--space-3xl);">
    <h1>Real-Time Command Stream</h1>
    <p style="color: var(--text-secondary); font-size: 1.05rem;">
        Watch live device status, spot problems early and act on them.
    </p>
</div>

@if (_error is not null)
{
    <p class="cmd-error">⚠ @_error</p>
}

<section class="stat-grid">
    <div class="stat-card">
        <div class="stat-label">Devices</div>
        <div class="stat-value">@_devices.Count</div>
    </div>
    <div class="stat-card ok">
        <div class="stat-label">Online</div>
        <div class="stat-value">@CountWith(DeviceStatus.Online)</div>
    </div>
    <div class="stat-card bad">
        <div class="stat-label">In alert</div>
        <div class="stat-value">@CountWith(DeviceStatus.Alert)</div>
    </div>
    <div class="stat-card muted">
        <div class="stat-label">Offline</div>
        <div class="stat-value">@CountWith(DeviceStatus.Offline)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Queued (normal / critical)</div>
        <div class="stat-value">@_queue.StandardQueued / @_queue.CriticalQueued</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Duplicate alerts blocked</div>
        <div class="stat-value">@_alerts.SuppressedDuplicates</div>
    </div>
</section>

<section class="card filter-card">
    <h2>Find devices</h2>
    <div class="filter-bar">
        <div class="form-row">
            <label for="device-search">Search by device ID or location</label>
            <input id="device-search" type="text" autocomplete="off"
                   placeholder="e.g. Hydroponics or AA:BB:CC:DD:EE:11"
                   value="@State.SearchText"
                   @oninput="OnSearchInput"
                   @onkeydown="OnSearchKeyDown" />
        </div>
        <div class="form-row">
            <label for="category-filter">Category</label>
            <select id="category-filter" value="@(State.CategoryFilter?.ToString() ?? "")" @onchange="OnCategoryChanged">
                <option value="">All categories</option>
                @foreach (var category in Enum.GetValues<SensorCategory>())
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label for="status-filter">Status</label>
            <select id="status-filter" value="@(State.StatusFilter?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<DeviceStatus>())
                {
                    <option value="@status">@StatusLabel(status)</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <button type="button" class="btn-primary" @onclick="SubmitSearchAsync">Search</button>
            <button type="button" class="btn-secondary" @onclick="ClearFiltersAsync" disabled="@(!FiltersActive)">Clear</button>
        </div>
    </div>
    <p class="filter-hint">
        The list narrows as you type. Press Enter or Search to save a search so the Suggested Actions engine can learn from it.
    </p>
</section>

<section class="card">
    <div class="live-indicator">
        <span class="live-dot"></span>
        <h2 class="live-heading">Live devices</h2>
    </div>
    <p style="color: var(--text-tertiary); margin-bottom: var(--space-lg);">
        Refreshes every 2 seconds. Devices that need attention are listed first.
        Showing @_results.Count of @_devices.Count device@(_devices.Count != 1 ? "s" : "").
    </p>

    @if (_devices.Count == 0)
    {
        <p style="color: var(--text-tertiary); padding: var(--space-xl) 0; text-align: center;">
            No devices registered yet. Register sensors, or start the simulator.
        </p>
    }
    else if (_results.Count == 0)
    {
        <p style="color: var(--text-tertiary); padding: var(--space-xl) 0; text-align: center;">
            No devices match your search or filters.
            <button type="button" class="btn-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
        </p>
    }
    else
    {
        <div class="table-scroll">
            <table class="sensor-table">
                <thead>
                    <tr>
                        <th>Device ID</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Last reading</th>
                        <th>Last seen</th>
                        <th>Active alerts</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in SortedDevices)
                    {
                        <tr class="row-@d.Status.ToString().ToLower()">
                            <td class="mono">@d.MacAddress</td>
                            <td>@d.DeploymentLocation</td>
                            <td>@d.Category</td>
                            <td>
                                <span class="status-badge status-@d.Status.ToString().ToLower()">@StatusLabel(d.Status)</span>
                            </td>
                            <td>@(d.LastValue is null ? "—" : $"{d.LastValue.Value:F1} {d.LastUnit}")</td>
                            <td>@Ago(d.LastSeen)</td>
                            <td>@AlertsFor(d.MacAddress)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<section class="card override-card">
    <h2>Manual override</h2>
    <p class="override-hint">
        Send a command to a device. Every command is pushed onto a stack, so Undo always reverses the most recent one first.
    </p>

    <div class="override-bar">
        <div class="form-row">
            <label for="override-device">Device</label>
            <select id="override-device" value="@State.CommandDeviceId" @onchange="OnCommandDeviceChanged">
                <option value="">Select a device…</option>
                @foreach (var device in _devices.OrderBy(x => x.DeploymentLocation))
                {
                    <option value="@device.MacAddress">@device.DeploymentLocation (@device.MacAddress)</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label for="override-control">Control</label>
            <select id="override-control" value="@State.CommandName" @onchange="OnCommandNameChanged">
                @foreach (var control in ControlNames)
                {
                    <option value="@control">@control</option>
                }
            </select>
        </div>
        <div class="override-actions">
            <button type="button" class="btn-primary" disabled="@(!CanSend)" @onclick="@(() => SendCommandAsync("On"))">Turn on</button>
            <button type="button" class="btn-secondary" disabled="@(!CanSend)" @onclick="@(() => SendCommandAsync("Off"))">Turn off</button>
            <button type="button" class="btn-secondary" disabled="@(_history.Count == 0)" @onclick="UndoAsync">Undo last</button>
        </div>
    </div>

    @if (_commandMessage is not null)
    {
        <p class="@(_commandFailed ? "cmd-error" : "cmd-ok")">@_commandMessage</p>
    }
</section>

<section class="card">
    <h2>Command history</h2>
    @if (_history.Count == 0)
    {
        <p style="color: var(--text-tertiary); padding: var(--space-md) 0; text-align: center;">
            No commands issued yet.
        </p>
    }
    else
    {
        <ul class="history-list">
            @foreach (var (command, index) in _history.Take(10).Select((c, i) => (c, i)))
            {
                <li class="history-item @(index == 0 ? "history-latest" : "")">
                    <span class="history-control">@command.Name</span>
                    <span>@DeviceName(command.DeviceId)</span>
                    <span class="history-change">@command.PreviousState → @command.State</span>
                    <span class="history-time">@Ago(command.IssuedAt)</span>
                    @if (index == 0)
                    {
                        <span class="history-tag">next to undo</span>
                    }
                </li>
            }
        </ul>
        @if (_history.Count > 10)
        {
            <p class="override-hint">Showing the 10 most recent of @_history.Count commands.</p>
        }
    }
</section>
@code {
    private List<SensorRecord> _devices = new();   // every registered device (for the summary cards)
    private List<SensorRecord> _results = new();   // devices matching the current search and filters
    private PipelineStatus _queue = new();
    private AlertsResponse _alerts = new();
    private string? _error;
    private readonly CancellationTokenSource _cts = new();
    private static readonly string[] ControlNames = { "WaterPump", "Relay1", "Valve1" };
    private List<CommandRecord> _history = new();   // newest first, straight from the API's stack
    private string? _commandMessage;
    private bool _commandFailed;

    private bool FiltersActive =>
        !string.IsNullOrWhiteSpace(State.SearchText) ||
        State.CategoryFilter is not null ||
        State.StatusFilter is not null;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = PollAsync(_cts.Token);
    }

    // Re-reads everything from the API every 2 seconds until the user leaves the page.
    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    // logSearch is true only when the user deliberately submits a search, so the
    // suggestion engine learns from real searches and not from background refreshes.
      private async Task RefreshAsync(bool logSearch = false)
    {
        try
        {
            var devicesTask = Api.GetSensorsAsync();
            var resultsTask = Api.SearchDevicesAsync(State.SearchText, State.CategoryFilter, State.StatusFilter, logSearch);
            var queueTask = Api.GetPipelineStatusAsync();
            var alertsTask = Api.GetAlertsAsync();
            var historyTask = Api.GetCommandHistoryAsync();
            await Task.WhenAll(devicesTask, resultsTask, queueTask, alertsTask, historyTask);

            _devices = devicesTask.Result;
            _results = resultsTask.Result;
            _queue = queueTask.Result;
            _alerts = alertsTask.Result;
            _history = historyTask.Result;
            _error = null;
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the API. Check that SmartX.API is running.";
        }
    }

    // ----- Search and filter handlers (the values are kept in AppState) -----

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        State.SearchText = e.Value?.ToString() ?? string.Empty;
        await RefreshAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitSearchAsync();
    }

    private Task SubmitSearchAsync() => RefreshAsync(logSearch: true);

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        State.CategoryFilter = Enum.TryParse<SensorCategory>(e.Value?.ToString(), out var category) ? category : null;
        await RefreshAsync();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        State.StatusFilter = Enum.TryParse<DeviceStatus>(e.Value?.ToString(), out var status) ? status : null;
        await RefreshAsync();
    }

    private async Task ClearFiltersAsync()
    {
        State.SearchText = string.Empty;
        State.CategoryFilter = null;
        State.StatusFilter = null;
        await RefreshAsync();
    }

    // Alert and offline devices first, then online, then devices that have not reported yet.
    private IEnumerable<SensorRecord> SortedDevices =>
        _results.OrderBy(d => Rank(d.Status)).ThenBy(d => d.DeploymentLocation);

    private static int Rank(DeviceStatus status) => status switch
    {
        DeviceStatus.Alert => 0,
        DeviceStatus.Offline => 1,
        DeviceStatus.Online => 2,
        _ => 3
    };

    private int CountWith(DeviceStatus status) => _devices.Count(d => d.Status == status);

    private static string StatusLabel(DeviceStatus status) =>
        status == DeviceStatus.Registered ? "Awaiting data" : status.ToString();

    private string AlertsFor(string mac)
    {
        var types = _alerts.Active.Where(a => a.DeviceId == mac).Select(a => a.Type).ToList();
        return types.Count == 0 ? "—" : string.Join(", ", types);
    }

    private static string Ago(DateTime? time)
    {
        if (time is null) return "never";

        var seconds = (int)Math.Max(0, (DateTime.UtcNow - time.Value.ToUniversalTime()).TotalSeconds);
        return seconds switch
        {
            < 60 => $"{seconds}s ago",
            < 3600 => $"{seconds / 60}m ago",
            _ => $"{seconds / 3600}h ago"
        };
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
    private bool CanSend =>
        !string.IsNullOrEmpty(State.CommandDeviceId) && !string.IsNullOrEmpty(State.CommandName);

    private void OnCommandDeviceChanged(ChangeEventArgs e) =>
        State.CommandDeviceId = e.Value?.ToString() ?? string.Empty;

    private void OnCommandNameChanged(ChangeEventArgs e) =>
        State.CommandName = e.Value?.ToString() ?? string.Empty;

    private async Task SendCommandAsync(string state)
    {
        if (!CanSend) return;

        try
        {
            var issued = await Api.IssueCommandAsync(State.CommandDeviceId, State.CommandName, state);
            SetMessage(issued is null
                ? "The API rejected that command."
                : $"Sent: {issued.Name} {issued.State} on {DeviceName(issued.DeviceId)}.",
                failed: issued is null);
            await RefreshAsync();
        }
        catch (HttpRequestException)
        {
            SetMessage("Cannot reach the API. Check that SmartX.API is running.", failed: true);
        }
    }

    private async Task UndoAsync()
    {
        try
        {
            var undone = await Api.UndoCommandAsync();
            SetMessage(undone is null
                ? "There are no commands to undo."
                : $"Undone: {undone.Name} on {DeviceName(undone.DeviceId)} set back to {undone.PreviousState}.",
                failed: undone is null);
            await RefreshAsync();
        }
        catch (HttpRequestException)
        {
            SetMessage("Cannot reach the API. Check that SmartX.API is running.", failed: true);
        }
    }

    private void SetMessage(string message, bool failed)
    {
        _commandMessage = message;
        _commandFailed = failed;
    }

    private string DeviceName(string mac) =>
        _devices.FirstOrDefault(d => d.MacAddress == mac)?.DeploymentLocation ?? mac;
}
