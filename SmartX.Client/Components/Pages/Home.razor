@page "/"
@using SmartX.Client.Services
@inject NavigationManager Nav
@inject AppState State

<PageTitle>Smart-X Gateway | IoT Telemetry &amp; Mesh Architecture</PageTitle>

<section class="hero">
    <div class="hero-content">
        <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>Gateway Engine Active</span>
            <span class="badge-divider">|</span>
            <span class="badge-spec">Mesh v2.4</span>
        </div>
        <h1>
            Monitor your <span class="accent">entire sensor</span> network in real-time.
        </h1>
        <p>
            Smart-X Gateway connects thousands of IoT sensors across your industrial infrastructure with self-healing mesh topology, predictive action streams, and sub-second anomaly detection.
        </p>
        <div class="hero-actions">
            <a href="/sensors" class="btn-primary">
                <span>Open Sensor Ingestion</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
            <a href="/topology" class="btn-secondary">
                <span>View Mesh Topology</span>
            </a>
        </div>
    </div>

    <div class="hero-visual">
        <div class="hero-visual-element sensor">
            <div class="visual-header">
                <div class="metric-label">Connected Sensors</div>
                <div class="visual-indicator live"></div>
            </div>
            <div class="metric-value">1,247</div>
            <div class="metric-detail">+12% deployed this week</div>
        </div>
        <div class="hero-visual-element network">
            <div class="visual-header">
                <div class="metric-label">Network Health</div>
                <div class="visual-indicator optimal"></div>
            </div>
            <div class="metric-value">99.7%</div>
            <div class="metric-detail">Prim MST backbone optimal</div>
        </div>
        <div class="hero-visual-element status">
            <div class="visual-header">
                <div class="metric-label">Gateway Status</div>
                <div class="visual-indicator active"></div>
            </div>
            <div class="metric-value status-accent">Online</div>
            <div class="metric-detail">4.2M readings / min processed</div>
        </div>
    </div>
</section>

<!-- Interactive Filter / Explore Section -->
<section class="overview-section">
    <div class="section-header">
        <div>
            <h2 class="section-title">Core Gateway Capabilities</h2>
            <p class="section-subtitle">Select and filter capabilities or dive straight into any of the 3 operational pillars</p>
        </div>
        <div class="filter-pills" role="tablist" aria-label="Feature filters">
            <button type="button" 
                    class="filter-pill @(_selectedCategory == "all" ? "active" : "")" 
                    @onclick='() => _selectedCategory = "all"'>
                All Pillars (@TotalCards)
            </button>
            <button type="button" 
                    class="filter-pill @(_selectedCategory == "ingestion" ? "active" : "")" 
                    @onclick='() => _selectedCategory = "ingestion"'>
                Telemetry
            </button>
            <button type="button" 
                    class="filter-pill @(_selectedCategory == "commands" ? "active" : "")" 
                    @onclick='() => _selectedCategory = "commands"'>
                Commands
            </button>
            <button type="button" 
                    class="filter-pill @(_selectedCategory == "mesh" ? "active" : "")" 
                    @onclick='() => _selectedCategory = "mesh"'>
                Mesh Routing
            </button>
        </div>
    </div>

    <div class="feature-grid">
        @if (_selectedCategory == "all" || _selectedCategory == "ingestion")
        {
            <a href="/sensors" class="feature-card available card-anim">
                <div class="feature-header">
                    <div class="feature-number">01</div>
                    <div class="feature-icon icon-sensors">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zm0 10c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z" />
                        </svg>
                    </div>
                </div>
                <h3 class="feature-title">Sensor Data Ingestion &amp; Telemetry</h3>
                <p class="feature-description">
                    Register IoT nodes by MAC, ingest continuous sensor feeds, monitor battery and signal quality, and ingest batch telemetry files.
                </p>
                <div class="feature-tags">
                    <span class="feature-tag">Live Stream</span>
                    <span class="feature-tag">Batch Ingest</span>
                    <span class="feature-tag">AVL Tree Archive</span>
                </div>
                <div class="feature-footer">
                    <span class="feature-status">Available Now</span>
                    <span class="feature-arrow">→</span>
                </div>
            </a>
        }

        @if (_selectedCategory == "all" || _selectedCategory == "commands")
        {
            <a href="/commands" class="feature-card available card-anim">
                <div class="feature-header">
                    <div class="feature-number">02</div>
                    <div class="feature-icon icon-commands">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="4 17 10 11 4 5"></polyline>
                            <line x1="12" y1="19" x2="20" y2="19"></line>
                        </svg>
                    </div>
                </div>
                <h3 class="feature-title">Real-Time Command Stream &amp; History</h3>
                <p class="feature-description">
                    Issue priority overrides, manage circular buffer event history, inspect automated suggestion patterns, and safely undo command executions.
                </p>
                <div class="feature-tags">
                    <span class="feature-tag">Dual Queues</span>
                    <span class="feature-tag">Undo Stack</span>
                    <span class="feature-tag">Predictive Engine</span>
                </div>
                <div class="feature-footer">
                    <span class="feature-status">Available Now</span>
                    <span class="feature-arrow">→</span>
                </div>
            </a>
        }

        @if (_selectedCategory == "all" || _selectedCategory == "mesh")
        {
            <a href="/topology" class="feature-card available card-anim">
                <div class="feature-header">
                    <div class="feature-number">03</div>
                    <div class="feature-icon icon-mesh">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </div>
                </div>
                <h3 class="feature-title">Network Topology &amp; Mesh Routing</h3>
                <p class="feature-description">
                    Interactive SVG mesh diagram with Prim's algorithm Minimum Spanning Tree (MST), dynamic detour calculations, node failover, and hop latency metrics.
                </p>
                <div class="feature-tags">
                    <span class="feature-tag">Prim MST</span>
                    <span class="feature-tag">BFS Detours</span>
                    <span class="feature-tag">Graph Failover</span>
                </div>
                <div class="feature-footer">
                    <span class="feature-status">Available Now</span>
                    <span class="feature-arrow">→</span>
                </div>
            </a>
        }
    </div>
</section>

@code {
    private string _selectedCategory = "all";
    private int TotalCards => 3;
}
